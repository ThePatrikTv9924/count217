
<!DOCTYPE html>
<html lang="cs">
<head>
<meta charset="UTF-8">
<title>Odpočet</title>
<style>
body { background:#0a0a0a; color:white; font-family:Arial; text-align:center; margin-top:80px; }
#timer { font-size:48px; font-weight:bold; letter-spacing:2px; }
</style>
</head>
<body>
<h1>Odpočet</h1>
<div id="timer"></div>
<script>
function startCountdown() {
  const target = new Date(Date.now() + 17*24*60*60*1000);
  target.setHours(12,0,0,0);
  function update() {
    const now = new Date();
    const diff = target - now;
    if(diff <= 0){ document.getElementById("timer").innerHTML="HOTOVO"; return; }
    const d = Math.floor(diff/86400000);
    const h = Math.floor((diff%86400000)/3600000);
    const m = Math.floor((diff%3600000)/60000);
    const s = Math.floor((diff%60000)/1000);
    document.getElementById("timer").innerHTML = d+"d "+h+"h "+m+"m "+s+"s";
  }
  update();
  setInterval(update,1000);
}
startCountdown();
</script>
</body>
</html>
